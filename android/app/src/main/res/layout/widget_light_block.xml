<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/light_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingHorizontal="14dp"
    android:paddingVertical="12dp">
    <!-- Heights must match LightBlockPlanner (padding 12/14 dp, 4 dp gaps). -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <ImageView android:id="@+id/light_icon" android:layout_width="20dp" android:layout_height="20dp" android:layout_marginEnd="6dp" android:importantForAccessibility="no" android:src="@drawable/ic_widget_light_unknown" />
        <TextView android:id="@+id/light_primary" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:maxLines="1" android:textColor="#A0AEB8" android:textSize="15sp" android:textStyle="bold" android:text="@string/widget_state_waiting_data" />
        <TextView android:id="@+id/light_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:clickable="true" android:focusable="true" android:includeFontPadding="false" android:maxLines="1" android:textColor="#8B9BA7" android:textSize="10sp" android:visibility="gone" />
        <TextView android:id="@+id/light_refresh" android:layout_width="24dp" android:layout_height="24dp" android:clickable="true" android:focusable="true" android:gravity="center" android:contentDescription="@string/widget_refresh_description" android:text="@string/widget_refresh" android:textColor="#36C6D5" android:textSize="15sp" android:visibility="gone" />
    </LinearLayout>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/light_duration" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:maxLines="1" android:textColor="#F3F7FA" android:textSize="24sp" android:textStyle="bold" android:visibility="gone" />
    <TextView android:id="@+id/light_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:maxLines="1" android:textColor="#C9D5DC" android:textSize="12sp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <TextView android:id="@+id/light_reserve" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:maxLines="1" android:textColor="#C9D5DC" android:textSize="12sp" android:visibility="gone" />
    <TextView android:id="@+id/light_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:includeFontPadding="false" android:maxLines="1" android:textColor="#8B9BA7" android:textSize="11sp" android:visibility="gone" />
</LinearLayout>

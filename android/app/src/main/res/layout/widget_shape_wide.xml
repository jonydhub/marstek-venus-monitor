<!-- 4×2: header, state lines, today's durations and the today+tomorrow schedule bar; spacers share extra height,
     rows are ordered by importance so a very short cell clips the least important bottom part. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:paddingStart="14dp"
    android:paddingEnd="8dp"
    android:paddingVertical="8dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_light_dot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="5dp" android:includeFontPadding="false" android:text="@string/widget_dot" android:textColor="#6F8290" android:textSize="15sp" />
        <TextView android:id="@+id/widget_soc_text" android:layout_width="wrap_content" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F3F7FA" android:textSize="30sp" android:textStyle="bold" android:maxLines="1" android:text="@string/widget_soc_compact_unknown" />
        <TextView android:id="@+id/widget_capacity_text" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:layout_marginStart="10dp" android:includeFontPadding="false" android:textColor="#B9CBD4" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:text="@string/widget_kwh_unknown" />
        <TextView android:id="@+id/widget_updated" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginEnd="2dp" android:includeFontPadding="false" android:textColor="#8B9BA7" android:textSize="9sp" android:maxLines="1" android:text="@string/widget_mini_dash" />
        <TextView android:id="@+id/widget_refresh" android:layout_width="30dp" android:layout_height="30dp" android:clickable="true" android:focusable="true" android:gravity="center" android:contentDescription="@string/widget_refresh_description" android:text="@string/widget_refresh" android:textColor="#36C6D5" android:textSize="16sp" />
        <TextView android:id="@+id/widget_settings" android:layout_width="30dp" android:layout_height="30dp" android:clickable="true" android:focusable="true" android:gravity="center" android:contentDescription="@string/widget_settings_description" android:text="@string/widget_settings" android:textColor="#9FC3D1" android:textSize="14sp" />
    </LinearLayout>
    <ImageView android:id="@+id/widget_soc_bar" android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="5dp" android:contentDescription="@null" android:scaleType="fitXY" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="1dp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:id="@+id/widget_primary" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#F3F7FA" android:textSize="14sp" android:textStyle="bold" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="0dp" android:text="@string/widget_state_waiting_data" />
        <TextView android:id="@+id/widget_line_1" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#C9D5DC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_line_2" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#C9D5DC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
        <TextView android:id="@+id/widget_line_3" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#C9D5DC" android:textSize="12sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:visibility="gone" />
    </LinearLayout>
    <TextView android:id="@+id/widget_today" android:layout_width="match_parent" android:layout_height="wrap_content" android:includeFontPadding="false" android:textColor="#A8B8C2" android:textSize="11sp" android:maxLines="1" android:ellipsize="end" android:layout_marginTop="5dp" android:layout_marginEnd="6dp" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="1dp" />
    <LinearLayout android:id="@+id/widget_schedule_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:layout_marginEnd="6dp" android:orientation="vertical" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/widget_schedule_caption" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:textColor="#8B9BA7" android:textSize="9sp" android:maxLines="1" android:ellipsize="end" />
            <TextView android:id="@+id/widget_schedule_caption_tomorrow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:includeFontPadding="false" android:textColor="#8B9BA7" android:textSize="9sp" android:maxLines="1" android:text="@string/widget_schedule_tomorrow" android:paddingStart="4dp" />
        </LinearLayout>
        <ImageView android:id="@+id/widget_schedule_bar" android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="3dp" android:scaleType="fitXY" android:contentDescription="@string/widget_schedule_description" />
    </LinearLayout>
</LinearLayout>

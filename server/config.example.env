# Marstek Venus monitor — server configuration.
# Copy to server/.env (or point MARSTEK_CONFIG=/path/to/file). Real environment variables win.

# --- Battery (required) ---------------------------------------------------
# LAN IP of the Venus E with Open API enabled; give it a DHCP reservation in the router.
MARSTEK_HOST=
# UDP port configured in the Marstek app for Open API (default 30000).
MARSTEK_PORT=30000

# --- HTTP dashboard / API -------------------------------------------------
# 127.0.0.1 = only this machine. 0.0.0.0 = every interface (set a token!).
MARSTEK_BIND=127.0.0.1
MARSTEK_DASHBOARD_PORT=8767
# If set, /api/* requires "Authorization: Bearer <token>". Generate: openssl rand -hex 24
MARSTEK_API_TOKEN=
# Requests per minute per client IP for /api/*.
MARSTEK_RATE_LIMIT_PER_MIN=120

# --- Outage schedule ------------------------------------------------------
# auto       = direct official API (LOE for lviv, YASNO for kyiv/dnipro/dnipro-cek) -> ua-outages -> svitlo.live
#              (default when MARSTEK_OUTAGE_REGION is set)
# ua-outages = hukpo/ua-outages aggregate of official operator schedules only
# svitlo     = svitlo.live aggregator only
# loe / yasno = that official source only;  off = no schedule (grid state + autonomy still work)
MARSTEK_OUTAGE_PROVIDER=
# Region id (ua-outages ids): kyiv, kyiv-region, dnipro, dnipro-cek, odesa, lviv, kharkiv, ... Full list: GET /api/regions
# svitlo.live slugs (lvivska-oblast, kiivska-oblast, ...) are accepted too.
MARSTEK_OUTAGE_REGION=
# Queue / group, e.g. 1.1 (some regions use plain numbers: 1, 2, ...)
MARSTEK_OUTAGE_QUEUE=

# Optional, Lvivoblenergo only: address-level emergency outages (ids from power-api.loe.lviv.ua).
MARSTEK_OUTAGE_OTG_ID=
MARSTEK_OUTAGE_CITY_ID=
MARSTEK_OUTAGE_STREET_ID=
MARSTEK_OUTAGE_BUILDING=

# --- Grid detection & forecast -------------------------------------------
# Backup output draw (W) at or above which the grid is considered absent.
MARSTEK_BACKUP_THRESHOLD_W=5
# Average backup-output load in W for the autonomy forecast (empty = measured from history).
MARSTEK_EXPECTED_LOAD_W=

# --- Storage --------------------------------------------------------------
# SQLite history (48 h). Docker image uses /data/history.db.
MARSTEK_HISTORY_DB=
